{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nbiot.local/schema/external-stages-v1.json",
  "title": "NB-IoT external stage ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "packageDigest", "registryDigest", "updatedAtUtc", "stages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^run-[A-Fa-f0-9]+$" },
    "packageDigest": { "$ref": "#/$defs/sha256" },
    "registryDigest": { "$ref": "#/$defs/sha256" },
    "updatedAtUtc": { "type": "string", "format": "date-time" },
    "stages": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/stage" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*:)[^\\\\]+$"
    },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/packagePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "budget": {
      "oneOf": [
        { "type": "object", "maxProperties": 0 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetMachine", "availableMemoryBytes", "maxUE", "maxCaseSeconds", "maxSuiteSeconds", "maxProcesses"],
          "properties": {
            "targetMachine": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?!.*(?:\\.\\.|[\\\\/:]))[^\\r\\n]+$" },
            "availableMemoryBytes": { "type": "integer", "minimum": 1 },
            "maxUE": { "type": "integer", "minimum": 1 },
            "maxCaseSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "maxSuiteSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "maxProcesses": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dependencies", "command", "inputs", "outputs", "executionBudget", "requiredDecision", "configuration", "status", "inputDigest", "outputDigest", "reportPath", "registryInputDigest", "worker"],
      "properties": {
        "name": { "enum": ["validate", "pilot", "data", "assemble", "train", "freeze", "evaluate", "admit", "compare", "summarize"] },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["validate", "pilot", "data", "assemble", "train", "freeze", "evaluate", "admit", "compare", "summarize"] } },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "arguments"],
          "properties": {
            "executable": { "const": "matlab" },
            "arguments": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "const": "-batch" }, { "type": "string", "maxLength": 256 }], "items": false }
          }
        },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/fileDigest" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/fileDigest" } },
        "executionBudget": { "$ref": "#/$defs/budget" },
        "requiredDecision": { "enum": ["", "stage-2-technical-review", "professor-approval-for-5000-UE-load-pilot", "model-acceptance-review"] },
        "configuration": { "type": "object" },
        "status": { "enum": ["not-started", "running", "completed", "failed", "stale", "awaiting-review"] },
        "inputDigest": { "oneOf": [{ "const": "" }, { "$ref": "#/$defs/sha256" }] },
        "outputDigest": { "oneOf": [{ "const": "" }, { "$ref": "#/$defs/sha256" }] },
        "reportPath": { "oneOf": [{ "const": "" }, { "$ref": "#/$defs/packagePath" }] },
        "registryInputDigest": { "oneOf": [{ "const": "" }, { "$ref": "#/$defs/sha256" }] },
        "worker": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "maxItems": 0 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ownerProcessId", "ownerStartedAtUtc", "ownedProcesses"],
              "properties": {
                "ownerProcessId": { "type": "integer", "minimum": 1 },
                "ownerStartedAtUtc": { "type": "string", "format": "date-time" },
                "ownedProcesses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["processId", "startedAtUtc"],
                    "properties": {
                      "processId": { "type": "integer", "minimum": 1 },
                      "startedAtUtc": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
